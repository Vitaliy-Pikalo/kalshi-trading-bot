# copy this to .env and fill in your real values
# .env is gitignored — never commit real secrets
# .env.example IS committed to git — DO NOT put real values here

# kalshi credentials (use demo first, switch to prod for phase 4)
KALSHI_ENV=demo            # demo | prod
KALSHI_KEY_ID=             # uuid from kalshi settings
KALSHI_PRIVATE_KEY_PATH=   # absolute path to your .pem file (e.g. C:\Users\pikal\Documents\kalshi\kalshi-private.pem)

# api endpoints (auto-selected based on KALSHI_ENV; override only if needed)
# KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# db
DATABASE_URL=sqlite:///data/poker_quant.db

# risk limits (poker-style bankroll defaults)
BANKROLL_USD=100
MAX_RISK_PER_TRADE_PCT=1.0     # hard cap, never exceed
KELLY_FRACTION=0.25            # quarter-kelly = poker variance-tolerant standard
MIN_EDGE_PCT=3.0               # only trade when edge > this
DAILY_LOSS_LIMIT_PCT=5.0       # circuit breaker
DRAWDOWN_LIMIT_PCT=20.0        # full stop trigger

# logging
LOG_LEVEL=INFO
